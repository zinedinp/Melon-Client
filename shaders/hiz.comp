#version 450

// One level of the occlusion culling's depth pyramid: each texel the farthest
// (smallest, depth is reversed) of the 2x2 below it. Level 0 halves the depth
// buffer itself. Sizes halve rounding down, as Vulkan's mip levels do. Where
// the level below is odd, the last row and column take in its last texels
// too, so every pixel counts.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D dst;

layout(push_constant) uniform Push {
    ivec2 dst_size;
    ivec2 src_size;
} pc;

void main() {
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(at, pc.dst_size))) {
        return;
    }
    ivec2 last = pc.src_size - 1;
    ivec2 base = at * 2;
    ivec2 reach = ivec2(2) + ivec2(equal(at, pc.dst_size - 1)) * (pc.src_size & 1);
    float farthest = 1.0;
    for (int y = 0; y < reach.y; y++) {
        for (int x = 0; x < reach.x; x++) {
            farthest = min(farthest, texelFetch(src, min(base + ivec2(x, y), last), 0).r);
        }
    }
    imageStore(dst, at, vec4(farthest));
}
